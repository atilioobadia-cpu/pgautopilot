{
  "name": "pgautopilot",
  "version": "1.0.0",
  "type": "module",
  "description": "PGAutoPilot — an MCP server + HTTP dashboard that lets AI assistants and humans safely explore, query, and manage any PostgreSQL database. Zero setup, auto-discovery, production-safe.",
  "main": "dist/index.js",
  "bin": {
    "pgautopilot": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/bundle.mjs",
    "bundle": "node scripts/bundle.mjs",
    "sign": "node scripts/sign.mjs",
    "sign:gpg": "node scripts/sign.mjs --gpg",
    "verify": "node scripts/verify.mjs",
    "verify:gpg": "node scripts/verify.mjs --gpg",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "start:bundle": "node dist/pgautopilot.bundle.cjs",
    "start:bundle:http": "node dist/pgautopilot.bundle.cjs --http",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc --noEmit && eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postgresql",
    "postgres",
    "database",
    "ai",
    "llm",
    "claude",
    "cursor",
    "copilot",
    "sql",
    "database-tools",
    "schema-introspection"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cyberreinxy/pgautopilot"
  },
  "homepage": "https://github.com/cyberreinxy/pgautopilot#readme",
  "bugs": {
    "url": "https://github.com/cyberreinxy/pgautopilot/issues"
  },
  "license": "MIT",
  "author": "Cyber Reinxy",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.0",
    "globals": "^15.15.0",
    "prettier": "^3.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.63.0"
  }
}
